<?xml version="1.0" encoding="utf-8"?>
<!--
  God Eater Resurrection (US: PCSA00026)

  Menu FPS: Resurrection's settings / quest UI rewrites linear color surfaces
  every frame. Combined with surface sync this used to serialize readbacks and
  tank FPS until the menu closed. The renderer now drops in-flight intermediate
  PostSurfaceSyncRequest entries (see queue_post_surface_sync). Rage Burst 2
  does not need this path as heavily.

  Copy to: <data>/config/config_<app_path>.xml  (app_path is usually the title ID)
  Or set the same knobs under Library → long-press game → Settings.
-->
<config>
    <core modules-mode="1">
        <lle-modules>
            <module>sceJobQueue</module>
            <module>sceAudio</module>
            <module>sceAvplayer</module>
            <module>sceSsl</module>
        </lle-modules>
    </core>

    <cpu cpu-opt="true"/>

    <gpu
        backend-renderer="Vulkan"
        gpu-idx="0"
        high-accuracy="true"
        resolution-multiplier="1.0"
        disable-surface-sync="false"
        screen-filter="Bilinear"
        memory-mapping="disabled"
        v-sync="true"
        anisotropic-filtering="2"
        async-pipeline-compilation="true"
        import-textures="false"
        export-textures="false"
        export-as-png="false"
        fps-hack="false"
        shader-cache="true"
        spirv-shader="false"
        texture-cache="true"/>

    <audio
        audio-backend="SDL"
        audio-volume="100"
        enable-ngs="true"/>

    <system
        pstv-mode="false"
        sys-button="0"
        sys-lang="0"
        sys-date-format="0"
        sys-time-format="0">
        <ime-langs>
            <lang>4</lang>
        </ime-langs>
    </system>

    <emulator
        file-loading-delay="0"
        stretch-the-display-area="false"
        fullscreen-hd-res-pixel-perfect="false"/>

    <debug
        log-active-shaders="false"
        log-uniforms="false"
        color-surface-debug="false"
        validation-layer="false"/>

    <network psn-signed-in="false"/>
</config>
